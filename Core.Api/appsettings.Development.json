{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=meshnetwork;Username=postgres;Password=your_password;Include Error Detail=true",
    "Redis": "localhost:6379"
  },
  "JwtSettings": {
    "SecretKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "MeshNetwork.API",
    "Audience": "MeshNetwork.Client",
    "ExpirationMinutes": 60
  },
  "NetworkSettings": {
    "MaxHopCount": 5,
    "NodeTimeoutSeconds": 300,
    "RoutingRefreshIntervalMinutes": 5,
    "MetricsRetentionDays": 30
  },
  "MqttSettings": {
    "BrokerHost": "localhost",
    "BrokerPort": 8883,
    "UseTls": true,
    "ClientId": "MeshNetworkBackend",
    "Username": "meshnetwork",
    "Password": "mqtt_password"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss} {Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/meshnetwork-.log",
          "rollingInterval": "Day",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}